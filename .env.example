# 飞书开放平台配置

# 应用 ID 和密钥（从开发者控制台获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# 管理员 Open ID（用于鉴权，给机器人发消息后从日志中获取）
ADMIN_OPEN_ID=ou_xxxxxxxxxxxx
# 会话卡片 id
CARD_TEMPLATE_ID=xxxxxx

# tmux 配置
TMUX_DEFAULT_LINES=50
TMUX_DEBUG=false

# 轮询配置
POLL_INTERVAL=3000
POLL_TIMEOUT=60000
POLL_STABLE_COUNT=2

# 重连配置
RECONNECT_MAX_RETRIES=5
RECONNECT_DELAY=5000

# 日志配置 (debug, info, warn, error)
LOG_LEVEL=debug
LOG_DIR=./logs
