{
  "name": "remote-im-controller",
  "version": "1.0.0",
  "description": "通过飞书远程控制 WSL 终端的 Node.js 守护进程",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "NODE_ENV=development tsx watch src/app.ts",
    "test:tmux": "tsx test/tmux_manager.test.ts",
    "test:feishu": "tsx test/feishu_bot.test.ts",
    "test:state": "tsx test/state_manager.test.ts",
    "test:core": "tsx test/core_processor.test.ts",
    "test:output": "tsx test/session_output_manager.test.ts",
    "test:lock": "tsx test/process_lock.test.ts",
    "test:router": "tsx test/command_router.test.ts",
    "test:adapter": "tsx test/local_adapter.test.ts",
    "local": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "bi": "node scripts/install-bot.cjs",
    "br": "node scripts/rename-bot.cjs",
    "bu": "node scripts/uninstall-bot.cjs"
  },
  "keywords": [
    "feishu",
    "tmux",
    "remote-control",
    "wsl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.30.0",
    "dotenv": "^17.3.1",
    "strip-ansi": "^7.1.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.11.0",
    "@types/strip-ansi": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
